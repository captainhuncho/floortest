{
  "name": "floortest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-admin-perms.ts && next build",
    "check:perms": "tsx scripts/check-admin-perms.ts && tsx scripts/check-desk-roles.ts && tsx scripts/check-rls.ts",
    "vercel-build": "tsx scripts/check-admin-perms.ts && npm run db:migrate && next build",
    "start": "next start",
    "seed": "tsx scripts/seed.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "tsx --conditions=react-server scripts/test-db-template.ts",
    "test": "tsx --conditions=react-server --test --test-force-exit tests/*.test.ts",
    "test:leaks": "tsx --conditions=react-server --import ./scripts/test-leak-probe.mjs --test --test-force-exit tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "e2e": "tsx scripts/e2e-slot.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@electric-sql/pglite": "^0.5.8",
    "@sentry/nextjs": "^11.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "music-metadata": "^12.0.0",
    "next": "^16.4.1",
    "opentype.js": "1.3.4",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.34.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/opentype.js": "1.3.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.1",
    "jsqr": "^1.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@sentry/bundler-plugins": {
      "glob": "14.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": ">=22.5"
  }
}
