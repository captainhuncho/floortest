<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FloorTest app privacy manifest (App Store Review 5.1.1/5.1.2, required-reason APIs). No tracking, no tracking domains.
  UserDefaults: SceneDelegate.swift keeps the ids of shares already routed (the app's own data) -> CA92.1.
  File timestamps: ShareInboxPlugin.swift reads creation dates of files in the app group's share inbox, and
  OfflineCratePlugin.swift reads file attributes (size) of files in the app's own container -> C617.1.
  Collected data types are declared in App Store Connect's privacy labels; keep both in step (docs/app-store-review.md).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
