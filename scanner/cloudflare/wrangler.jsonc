// FloorTest virus scanner on Cloudflare Containers: the same ClamAV image as ../Dockerfile, behind a small Worker.
// Cloudflare already holds the audio, so this adds no new subprocessor. Deploy from this folder: README, "Cloudflare".
{
  "name": "floortest-scanner",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Every 5 minutes: wake the scanner if it stopped (deploy, host move, crash) so an upload never waits on a cold start.
  "triggers": { "crons": ["*/5 * * * *"] },
  "containers": [
    {
      "class_name": "Scanner",
      "image": "../Dockerfile",
      // ClamAV holds about 1 GB of signatures, briefly twice that while it reloads them after an update. Memory is billed
      // as provisioned and CPU only as used, so the smallest custom size: 1 vCPU, 3 GiB (the minimum per vCPU), 4 GB disk.
      "instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 4000 },
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "SCANNER", "class_name": "Scanner" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scanner"] }]
}
