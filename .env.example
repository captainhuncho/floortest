# ─── Copy to .env.local for local overrides. In production, set these in your host's dashboard. ───
# Nothing is required for local development: it runs on an embedded Postgres and a local folder.

# Public URL of the app (used in emails, receipts, link previews). Required in production.
APP_URL=https://floortest.app

# Long random string (32+ chars) used to sign upload links. Required in production.
#   Generate with: openssl rand -base64 48
APP_SECRET=

# ─── Database ───
# Any Postgres. Leave unset locally to use the embedded database in DATA_DIR.
#   Supabase: use the "Transaction pooler" connection string (port 6543) for serverless hosts.
DATABASE_URL=
# Max connections per server instance (keep low on serverless).
DB_POOL_MAX=5
# Set to false if you run `npm run db:migrate` during deploys instead of migrating on first request.
DB_AUTO_MIGRATE=true

# Local-only data folder (embedded database + local file storage).
DATA_DIR=./data

# ─── File storage ───
# "s3" for any S3-compatible bucket (Cloudflare R2, Supabase Storage, AWS S3). Defaults to s3 when S3_BUCKET is set.
STORAGE_DRIVER=
S3_BUCKET=
S3_REGION=auto
#   R2:       https://<account-id>.r2.cloudflarestorage.com
#   Supabase: https://<project-ref>.supabase.co/storage/v1/s3  (and S3_FORCE_PATH_STYLE=true)
#   AWS S3:   leave empty and set S3_REGION
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Email (Resend) ───
# Without a key, emails are only recorded in-app, never delivered.
RESEND_API_KEY=
MAIL_FROM="FloorTest <team@floortest.app>"
MAIL_REPLY_TO=

# ─── Beta access ───
# Comma-separated shared codes. They only tag sign-ups once Open sign-up is on: while it's off (the beta) only a
# personal invite from Ops to that exact email opens an account (src/lib/invites.ts).
BETA_INVITE_CODES=
# Sign-ups allowed per invite code, so a leaked code can't open the doors (default 25).
BETA_INVITE_LIMIT=
# Coming-soon password in front of the whole site (live site only; previews ignore it). Unset = site open.
SITE_PASSWORD=

# ─── Scheduled jobs ───
# Protects /api/cron/digest and /api/cron/purge. Vercel Cron sends it automatically.
CRON_SECRET=

# ─── Optional links in the profile menu (hidden when empty) ───
SUPPORT_EMAIL=
INSTAGRAM_URL=
SHOP_URL=
TERMS_URL=
PRIVACY_URL=

# Encrypts nightly database backups (required). Keep a copy in a password manager: without it backups can't be read.
BACKUP_KEY=
# After changing BACKUP_KEY: the old key(s), comma-separated, until the last backup made with them is gone (14 days).
# Each backup names the key that sealed it, so restore picks the right one.
BACKUP_OLD_KEYS=

# Cloudflare Turnstile bot check (switched on/off in Admin → Feature switches).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Leaked-password check (Have I Been Pwned, k-anonymity) on sign-up, reset and change. On by default on Vercel;
# 1 turns it on elsewhere, 0 turns it off. Off locally and in tests when unset.
PWNED_CHECK=

# ─── Admin and ops ───
# Accounts (comma-separated emails) that can open the admin; they also need two-step sign-in on.
ADMIN_EMAILS=
# The separate ops address (e.g. https://ops.floortest.app). Previews ignore it.
OPS_URL=

# ─── Google sign-in (off when unset) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Email limits and delivery webhook ───
# Signing secret of the Resend webhook (/api/webhooks/resend): bounces and complaints. Unset = webhook refused.
RESEND_WEBHOOK_SECRET=
# Provider plan limits, so the app stops before the provider does (defaults 100 a day, 3000 a month).
MAIL_DAILY_LIMIT=
MAIL_MONTHLY_LIMIT=
# Most account emails (codes, resets, confirmations) the whole platform sends in an hour (default 300).
ACCOUNT_EMAIL_CAP=

# ─── Virus scanner (scanner/) ───
# Required on the live site: without both, every upload there is refused rather than accepted unscanned, and the
# detailed /api/health report fails. Previews and local copies run without a scanner.
SCAN_URL=
SCAN_SECRET=

# ─── Recovery copy (the vault: a second private bucket) ───
# All three set: nightly backups and a copy of every stored file go to this bucket, with its own key.
BACKUP_BUCKET=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=

# Optional: Discord or Slack incoming webhook for urgent alerts, alongside email.
ALERT_WEBHOOK_URL=

# Staging (Vercel previews) only: every email goes to this address instead of the real recipient. Unset = nothing is sent.
STAGING_EMAIL_TO=

# Sentry crash reporting (public project ID). Unset = off.
NEXT_PUBLIC_SENTRY_DSN=
