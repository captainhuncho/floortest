# ─── Copy to .env.local for local overrides. In production, set these in your host's dashboard. ───
# Nothing is required for local development: it runs on an embedded Postgres and a local folder.

# Public URL of the app (used in emails, receipts, link previews). Required in production.
APP_URL=https://floortest.app

# Long random string (32+ chars) used to sign upload links. Required in production.
#   Generate with: openssl rand -base64 48
APP_SECRET=

# ─── Database ───
# Any Postgres. Leave unset locally to use the embedded database in DATA_DIR.
#   Supabase: use the "Transaction pooler" connection string (port 6543) for serverless hosts.
DATABASE_URL=
# Max connections per server instance (keep low on serverless).
DB_POOL_MAX=5
# Set to false if you run `npm run db:migrate` during deploys instead of migrating on first request.
DB_AUTO_MIGRATE=true

# Local-only data folder (embedded database + local file storage).
DATA_DIR=./data

# ─── File storage ───
# "s3" for any S3-compatible bucket (Cloudflare R2, Supabase Storage, AWS S3). Defaults to s3 when S3_BUCKET is set.
STORAGE_DRIVER=
S3_BUCKET=
S3_REGION=auto
#   R2:       https://<account-id>.r2.cloudflarestorage.com
#   Supabase: https://<project-ref>.supabase.co/storage/v1/s3  (and S3_FORCE_PATH_STYLE=true)
#   AWS S3:   leave empty and set S3_REGION
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Email (Resend) ───
# Without a key, emails are only recorded in-app, never delivered.
RESEND_API_KEY=
MAIL_FROM="FloorTest <hello@floortest.app>"
MAIL_REPLY_TO=

# ─── Beta access ───
# "invite" (default in production) or "open".
SIGNUP_MODE=invite
# Comma-separated codes you hand to beta testers. Existing users' referral codes also work.
BETA_INVITE_CODES=

# ─── Scheduled jobs ───
# Protects /api/cron/digest (hourly) and /api/cron/purge (daily). Vercel Cron sends it automatically.
CRON_SECRET=

# ─── Optional links in the profile menu (hidden when empty) ───
SUPPORT_EMAIL=
INSTAGRAM_URL=
SHOP_URL=
TERMS_URL=
PRIVACY_URL=
