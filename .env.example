# Public URL used in sender emails and tracking links
APP_URL=http://localhost:3000
# Where the SQLite DB and uploaded audio live
DATA_DIR=./data
# Optional: send real emails through Resend. Without these, emails are logged to the in-app outbox.
RESEND_API_KEY=
MAIL_FROM="FloorTest <notifications@example.com>"
# Optional links in the profile menu. Leave blank to hide.
SUPPORT_EMAIL=
INSTAGRAM_URL=
SHOP_URL=
TERMS_URL=
PRIVACY_URL=
# Protects /api/cron/digest (call it hourly with "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=
